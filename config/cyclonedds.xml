<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS tuning for the camera streams. Depth (RVL) and color (H.264) frames
  are large; the default UDP socket buffers overflow under burst and the receiver
  drops samples. Enlarge both the send (Tx) and receive (Rx) socket buffers so a
  full frame fits without loss. One file serves both sides.

  NOTE: the OS caps these at net.core.wmem_max / net.core.rmem_max. With Docker
  `network host`, the container shares the HOST net namespace, so raise the
  limits on the HOST for the full 16MB to take effect (otherwise CycloneDDS is
  silently clamped):
      sudo sysctl -w net.core.wmem_max=16777216 net.core.rmem_max=16777216
  (persist in /etc/sysctl.d/*.conf).

  Pointed to by CYCLONEDDS_URI (set in docker/Dockerfile).
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <!-- The NIC toward the DDS peers on THIS machine (robot LAN interface
           on the G1 onboard PC, e.g. eth0; "lo" for same-machine testing).
           It must be named HERE: the runners pass an empty interface to the
           SDK on purpose — a non-empty one makes ChannelFactory::Init build
           its own DDS config and silently discard this whole file. -->
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="default"/>
      </Interfaces>
      <!-- Keep each UDP datagram within one MTU. The default MaxMessageSize
           (14720 B) bundles ~10 RTPS fragments per datagram, which the IP
           layer re-fragments on a 1500-MTU LAN: one lost wire packet then
           costs ten fragments at once, and kernel reassembly adds its own
           failure mode (IpReasmFails observed on the receiver). Trade-off:
           ~10x more sendmsg() calls on the transmitter per frame. -->
      <FragmentSize>1344 B</FragmentSize>
      <MaxMessageSize>1400 B</MaxMessageSize>
      <MaxRexmitMessageSize>1400 B</MaxRexmitMessageSize>
    </General>
    <Internal>
      <SocketSendBufferSize min="16MiB"/>
      <SocketReceiveBufferSize min="16MiB"/>
    </Internal>
    <!-- Diagnostics: uncomment to have CycloneDDS log the fully resolved
         configuration (verifies these settings actually apply).
    <Tracing>
      <Verbosity>config</Verbosity>
      <OutputFile>/tmp/cyclonedds.log</OutputFile>
    </Tracing>
    -->
  </Domain>
</CycloneDDS>
