// Custom DDS types for compressed camera frames, generated by CycloneDDS
// idlc (cxx backend). Fields mirror the C++ frame structs
// (H264ColorFrame / RvlDepthFrame). `data` is the compressed payload
// (Annex-B H.264 for color, RVL bitstream for depth) — the wire carries
// the fields natively, replacing the hand-rolled byte-blob serialization.

module kist_msgs {

    struct CompressedColorFrame {
        uint32          width;
        uint32          height;
        uint64          seq;        // 'sequence' is an IDL keyword
        int64           stamp_ns;
        boolean         is_keyframe;
        string          frame_id;
        sequence<octet> data;   // Annex-B H.264 NAL units
    };

    struct CompressedDepthFrame {
        uint32          width;
        uint32          height;
        uint64          seq;        // 'sequence' is an IDL keyword
        int64           stamp_ns;
        float           depth_scale;
        // Pinhole intrinsics of THIS frame (px). With align_to_color the depth
        // is reprojected into the color frame, so these are the color stream's
        // intrinsics — the consumer deprojects depth->3D with them directly:
        //   Z = raw*depth_scale;  X = (u-cx)*Z/fx;  Y = (v-cy)*Z/fy
        float           fx;
        float           fy;
        float           cx;         // principal point x (ppx)
        float           cy;         // principal point y (ppy)
        string          frame_id;
        sequence<octet> data;   // RVL bitstream
    };

};
